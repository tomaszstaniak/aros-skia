# HarfBuzz text shaping. Bash, sourced by scripts/deps/*.sh.
# WebKitGTK 2.54 OptionsGTK.cmake: find_package(HarfBuzz 2.7.4 REQUIRED
# COMPONENTS ICU). Skia m154 DEPS pins a git snapshot; any recent release
# satisfies both, so this tracks the latest stable release.
RECIPE_NAME=harfbuzz
RECIPE_VERSION=14.5.0
RECIPE_URL=https://github.com/harfbuzz/harfbuzz/releases/download/14.5.0/harfbuzz-14.5.0.tar.xz
RECIPE_SHA256=b7132e148358a45185c9feafd049dbaf243649d3c44414b3534d9c95d18592b9
RECIPE_ARCHIVE=harfbuzz-14.5.0.tar.xz
RECIPE_SRCDIR=harfbuzz-14.5.0
RECIPE_LICENSE="MIT (COPYING)"
RECIPE_LICENSE_FILES="COPYING"

# CMake, not meson: the host has no meson, and the CMake file (community
# maintained upstream) builds the same library.
#
# Configure checks only compile (see aros-x86_64.cmake), so every HAVE_*
# that HarfBuzz derives from check_function_exists is seeded here with the
# answer from a real collect-aros link probe (2026-09-24, ABIv11 SDK):
# atexit/sysconf/isatty link; mmap/mprotect/getpagesize/newlocale/uselocale
# do not, and <sys/mman.h>/<xlocale.h> are absent.
#
# FreeType is the SDK's *static* archive by path; the SDK's freetype2.pc
# is unusable (unsubstituted %PKGCONFIG_*% fields) and -lfreetype2 is the
# shared-library stub. The headers live directly in $AROS_SDK/include.
#
# ICU: off by default. HB_WITH_ICU=ON also builds libharfbuzz-icu.a against
# the SDK's static ICU 61.1 (libicuuc.a + libicudata.a); that compiles and
# links (see deps/README.md), but WebKitGTK 2.54 asks for ICU >= 70.1, so a
# newer ICU is its own dependency decision, not this recipe's default.
#
# Subset/raster/vector/gpu are separate optional libraries nobody here
# consumes yet; off keeps the recipe to the shaping core.
RECIPE_CMAKE_ARGS=(
  -DHB_HAVE_FREETYPE=ON
  -DHB_HAVE_ICU="${HB_WITH_ICU:-OFF}"
  -DHB_HAVE_GLIB=OFF -DHB_HAVE_GOBJECT=OFF -DHB_HAVE_CAIRO=OFF
  -DHB_HAVE_GRAPHITE2=OFF -DHB_HAVE_INTROSPECTION=OFF
  -DHB_BUILD_UTILS=OFF -DHB_BUILD_SUBSET=OFF -DHB_BUILD_RASTER=OFF
  -DHB_BUILD_VECTOR=OFF -DHB_BUILD_GPU=OFF -DHB_BUILD_GPU_DEMO=OFF
  -DFREETYPE_INCLUDE_DIR_ft2build="$AROS_SDK/include"
  -DFREETYPE_INCLUDE_DIR_freetype2="$AROS_SDK/include"
  -DFREETYPE_LIBRARY="$AROS_SDK/lib/libfreetype2.static.a"
  -DHAVE_ATEXIT=1 -DHAVE_SYSCONF=1 -DHAVE_ISATTY=1
  -DHAVE_MMAP=0 -DHAVE_MPROTECT=0 -DHAVE_GETPAGESIZE=0
  -DHAVE_SYS_MMAN_H=0 -DHAVE_UNISTD_H=1 -DHAVE_STDBOOL_H=1
  -DHAVE_FT_GET_VAR_BLEND_COORDINATES=1 -DHAVE_FT_SET_VAR_BLEND_COORDINATES=1
  -DHAVE_FT_DONE_MM_VAR=1 -DHAVE_FT_GET_TRANSFORM=1
)

# Installed metadata as CMake wrote it names SDK archives by absolute path,
# asks pkg-config for the SDK's broken freetype2.pc / icu-uc, and uses
# -pthread / Threads::Threads. Rewrite to the static-archive chain
# consumers must link (FreeType needs png/zlib for its sfnt/gzip modules;
# ICU needs its data archive), relative to the consumer's SDK, with the
# real AROS pthread archive.
recipe_post_install() {
  python3 - "$DEPS_PREFIX" "$AROS_SDK" <<'PY'
import os, re, sys
prefix, sdk = sys.argv[1:3]
ft = ['libfreetype2.static.a', 'libpng_nostdio.a', 'libz.static.a']
icu = ['libicuuc.a', 'libicudata.a']

def pc_fix(name, chain):
    path = os.path.join(prefix, 'lib/pkgconfig', name + '.pc')
    if not os.path.exists(path):
        return
    t = open(path).read()
    t = re.sub(r'(?m)^Requires\.private:.*\n', '', t)
    t = re.sub(r'(?m)^Libs\.private:.*\n', '', t)
    libs = ' '.join('${aros_sdk}/lib/' + a for a in chain) + ' -lpthread -lm'
    t = re.sub(r'(?m)^(Libs:.*)$', lambda m: m.group(1) + '\nLibs.private: ' + libs, t, count=1)
    t = t.replace('includedir=${prefix}/include',
                  'includedir=${prefix}/include\n'
                  '# pkg-config --define-variable=aros_sdk="$AROS_SDK" --static --libs ' + name +
                  '\naros_sdk=${aros_sdk}', 1)
    open(path, 'w').write(t)

have_icu = os.path.exists(os.path.join(prefix, 'lib/libharfbuzz-icu.a'))
pc_fix('harfbuzz', ft + (icu if have_icu else []))
pc_fix('harfbuzz-icu', ft + icu)

cfg = os.path.join(prefix, 'lib/cmake/harfbuzz/harfbuzzConfig.cmake')
t = open(cfg).read()
t = t.replace(sdk + '/lib/libfreetype2.static.a',
              ';'.join('${CMAKE_SYSROOT}/lib/' + a for a in ft))
t = t.replace(sdk + '/lib/libicuuc.a',
              ';'.join('${CMAKE_SYSROOT}/lib/' + a for a in icu))
# Static link order: pthread after ICU/FreeType, which may call into it.
def move_pthread(m):
    items = [i for i in m.group(1).split(';') if i != 'Threads::Threads']
    return 'INTERFACE_LINK_LIBRARIES "%s"' % ';'.join(items + ['pthread'])
t = re.sub(r'INTERFACE_LINK_LIBRARIES "([^"]*Threads::Threads[^"]*)"', move_pthread, t)
if sdk in t or 'Threads::Threads' in t:
    sys.exit('harfbuzzConfig.cmake: unexpected SDK path left, recipe needs update')
open(cfg, 'w').write(t)
PY
}
