# libjpeg-turbo, libjpeg API only. Bash, sourced by scripts/deps/*.sh.
RECIPE_NAME=libjpeg-turbo
RECIPE_VERSION=3.2.0
RECIPE_URL=https://github.com/libjpeg-turbo/libjpeg-turbo/releases/download/3.2.0/libjpeg-turbo-3.2.0.tar.gz
RECIPE_SHA256=6f30092cef9fb839779646608f4ee14ae3cbac989c47fa05e841b0841f09878e
RECIPE_ARCHIVE=libjpeg-turbo-3.2.0.tar.gz
RECIPE_SRCDIR=libjpeg-turbo-3.2.0
RECIPE_LICENSE="IJG + BSD-3-Clause + zlib (LICENSE.md)"
RECIPE_LICENSE_FILES="LICENSE.md README.ijg"

# API: default libjpeg v6b (JPEG_LIB_VERSION 62), not WITH_JPEG8. Skia m154
# (SkJpegCodec/SkJpegEncoderImpl) needs only the turbo extensions that
# exist in every API level: JCS_EXT_RGBA/BGRA/RGBX, JCS_RGB565,
# jpeg_crop_scanline, jpeg_skip_scanlines. Chromium, Skia's own DEPS build
# and distro packages are all v62, and WebKit's JPEG decoder uses v62 too.
#
# TurboJPEG API, tools and tests off: nothing here needs tj*, and the
# test programs would need to run on the target.
#
# SIMD: controlled by JPEG_TURBO_SIMD (default ON). NASM emits elf64, which
# collect-aros links like any other ELF object. OFF is the fallback if a
# guest run ever shows a SIMD problem.
RECIPE_CMAKE_ARGS=(
  -DENABLE_SHARED=OFF -DENABLE_STATIC=ON
  -DWITH_JPEG7=OFF -DWITH_JPEG8=OFF
  -DWITH_TURBOJPEG=OFF -DWITH_TOOLS=OFF -DWITH_TESTS=OFF -DWITH_FUZZ=OFF
  -DWITH_SIMD="${JPEG_TURBO_SIMD:-ON}" -DREQUIRE_SIMD="${JPEG_TURBO_SIMD:-ON}"
  -DCMAKE_ASM_NASM_COMPILER="${NASM:-nasm}"
  -DCMAKE_INSTALL_DOCDIR=share/doc/libjpeg-turbo
)

# NASM records each .asm file's absolute path as an ELF file symbol, and
# -ffile-prefix-map does not reach NASM. File symbols take no part in
# relocation, so drop the ones that name this build machine's directories.
recipe_post_install() {
  local a="$DEPS_PREFIX/lib/libjpeg.a" oc="$AROS_GCC_ROOT/x86_64-aros-objcopy" args=()
  while IFS= read -r sym; do args+=("--strip-symbol=$sym"); done < <(
    "$AROS_NM" -a "$a" 2>/dev/null | awk '$2 == "a" && $3 ~ /^\// {print $3}' | sort -u)
  if [ "${#args[@]}" -gt 0 ]; then "$oc" "${args[@]}" "$a"; fi
}
