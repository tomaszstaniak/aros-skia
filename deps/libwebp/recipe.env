RECIPE_NAME=libwebp
RECIPE_VERSION=1.6.0
RECIPE_URL=https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-1.6.0.tar.gz
RECIPE_SHA256=e4ab7009bf0629fd11982d4c2aa83964cf244cffba7347ecd39019a9e38c4564
RECIPE_ARCHIVE=libwebp-1.6.0.tar.gz
RECIPE_SRCDIR=libwebp-1.6.0
RECIPE_LICENSE="BSD-3-Clause + patent grant (COPYING, PATENTS)"
RECIPE_LICENSE_FILES="COPYING PATENTS"

# Libraries only: libwebp, libwebpdecoder, libwebpdemux, libwebpmux,
# libsharpyuv. Tools/extras off (they would need libpng/jpeg/gif/GL and
# can only run on the target).
#
# Threads: AROS libpthread.a is a real static implementation, so the
# worker-thread decoder stays on (WEBP_USE_THREAD). SIMD: SSE2/SSE4.1
# intrinsics with runtime CPU detection (cpuid), no external assembler.
RECIPE_CMAKE_ARGS=(
  -DWEBP_LINK_STATIC=ON
  -DWEBP_BUILD_ANIM_UTILS=OFF -DWEBP_BUILD_CWEBP=OFF -DWEBP_BUILD_DWEBP=OFF
  -DWEBP_BUILD_GIF2WEBP=OFF -DWEBP_BUILD_IMG2WEBP=OFF -DWEBP_BUILD_VWEBP=OFF
  -DWEBP_BUILD_WEBPINFO=OFF -DWEBP_BUILD_WEBPMUX=OFF -DWEBP_BUILD_EXTRAS=OFF
  -DWEBP_BUILD_FUZZTEST=OFF -DWEBP_BUILD_LIBWEBPMUX=ON
  -DWEBP_ENABLE_SIMD="${WEBP_SIMD:-ON}"
  -DWEBP_USE_THREAD=ON
  -DCMAKE_DISABLE_FIND_PACKAGE_PNG=ON -DCMAKE_DISABLE_FIND_PACKAGE_JPEG=ON
  -DCMAKE_DISABLE_FIND_PACKAGE_TIFF=ON -DCMAKE_DISABLE_FIND_PACKAGE_GIF=ON
  -DCMAKE_DISABLE_FIND_PACKAGE_OpenGL=ON -DCMAKE_DISABLE_FIND_PACKAGE_GLUT=ON
  -DCMAKE_DISABLE_FIND_PACKAGE_SDL2=ON
)
